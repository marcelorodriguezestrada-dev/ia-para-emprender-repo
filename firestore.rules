rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Posts generados: solo lectura/escritura para usuarios logueados
    // (vos y Daniel, ya filtrados por la lista blanca en el código).
    match /posts_generados/{docId} {
      allow read, write: if request.auth != null;
    }

    // Campañas completas generadas por IA (varios posts + calendario):
    // mismo criterio que posts_generados, solo para admins logueados.
    match /campanas_generadas/{docId} {
      allow read, write: if request.auth != null;
    }

    // Materiales de las clases (diapositivas, videos, accesos): mismo
    // criterio, solo para admins logueados.
    match /materiales/{docId} {
      allow read, write: if request.auth != null;
    }

    // Alumnos del curso pago: cualquiera puede inscribirse (create), pero
    // SIEMPRE arranca en "pendiente_pago" y sin notas — así nadie puede
    // mandarse a sí mismo como "pagado" falseando el campo. Leer, cambiar
    // el estado a pagado, o escribir notas, es solo para admins logueados.
    match /alumnos/{docId} {
      allow create: if request.resource.data.estado == "pendiente_pago"
                       && request.resource.data.notas == ""
                       && request.resource.data.nombre is string
                       && request.resource.data.email is string
                       && request.resource.data.idea is string;
      allow read, update, delete: if request.auth != null;
    }

    // Leads del formulario de /registro: cualquiera puede CREAR uno (es
    // público, sin login), pero solo un admin logueado puede leerlos —
    // así nadie puede scrapear la lista de mails de otra gente.
    match /leads/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Campañas UTM: la creación y el borrado son solo para admins logueados,
    // pero el conteo de clics (/go/[id]) lo dispara cualquier visitante
    // ANÓNIMO que hace clic en el link — por eso "update" tiene que estar
    // permitido sin auth, pero restringido a tocar solo el campo "clics".
    match /campanas_utm/{docId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(["clics"]);
    }
  }
}
